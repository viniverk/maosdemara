rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Produtos: o público só lê os visíveis; só o admin escreve
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Pedidos: a cliente pode CRIAR (checkout Pix); só o admin lê, atualiza e exclui
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['code', 'items', 'subtotal', 'shipping', 'total', 'customer', 'status', 'paymentMethod', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod in ['pix', 'card']
        && request.resource.data.createdAt == request.time
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.customer is map
        && request.resource.data.customer.size() <= 15;
      // a cliente, ao voltar do cartão, só pode anexar a referência do pagamento
      allow update: if resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentRef'])
        && request.resource.data.paymentRef is map
        && request.resource.data.paymentRef.size() <= 3;
      allow read, update, delete: if isAdmin();
    }

    // Lista de administradores: edite pelo Console do Firebase
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Configurações públicas (frete, hashtags)
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Produtos: o público só lê os visíveis; só o admin escreve
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Pedidos: criados apenas pelas Cloud Functions; admin lê e atualiza status
    match /orders/{id} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // Lista de administradores: edite pelo Console do Firebase
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Configurações públicas (frete, hashtags)
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

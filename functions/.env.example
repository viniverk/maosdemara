# Copie este arquivo para "functions/.env" e preencha.
# (Os TOKENS não ficam aqui — eles vão como "secrets", veja o README.)

# Endereço público do site (sem barra no final)
SITE_URL=https://SEU-PROJETO.web.app

# Nome que aparece na fatura do cartão (até 13 letras)
STORE_NAME=Maos de Mara

# --- Publicação automática no Instagram (opcional) ---
# ID da conta profissional do Instagram
IG_USER_ID=
# Use https://graph.instagram.com (login do Instagram) ou https://graph.facebook.com (login do Facebook)
IG_API_HOST=https://graph.instagram.com
IG_API_VERSION=v26.0
